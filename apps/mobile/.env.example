# Copy this file to `.env` (gitignored) and fill in your Supabase project's
# values — Project Settings -> API in the Supabase dashboard.
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time, which is
# why only the anon (public, RLS-scoped) key belongs here — never the
# service_role key. See CLAUDE.md's Gap 2 / RLS notes.

EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
